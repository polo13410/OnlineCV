{
  "name": "online-cv",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n fn,app -c yellow,cyan \"netlify functions:serve --port 9999\" \"ng serve\"",
    "dev": "npm run start",
    "build": "node scripts/build-info.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run test:ci && npm run test:e2e"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "$jasmine-core"
    }
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/jasmine": "6.0.0",
    "concurrently": "10.0.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "typescript": "6.0.3"
  }
}
